    },
    {
      "name": "RetroArch32 MAME",
      "default_core": true,
      "unique_id": "model2.ra32.mamearcade",
      "description": "Supported extensions: zip, 7z.",
      "is_retroachievements_compatible": false,
      "platforms": {
        "android": {
          "launch_arguments": "-n com.retroarch.ra32/com.retroarch.browser.retroactivity.RetroActivityFuture --es ROM \"{file.path}\" --es LIBRETRO \"mamearcade\""
        }
      }
    },
    {
      "name": "RetroArch MAME",
      "default_core": true,
      "unique_id": "model2.ra.mamearcade",
      "description": "Supported extensions: zip, 7z.",
      "is_retroachievements_compatible": false,
      "platforms": {
        "android": {
          "launch_arguments": "-n com.retroarch/com.retroarch.browser.retroactivity.RetroActivityFuture --es ROM \"{file.path}\" --es LIBRETRO \"mamearcade\""
        }
      }
    },
    {
      "name": "RetroArch MAME (Current)",
      "unique_id": "model2.ra.mame",
      "description": "Supported extensions: zip, 7z.",
      "is_retroachievements_compatible": false,
      "platforms": {
        "windows": {
          "executable": "retroarch.exe",
          "args": "-L mame_libretro.dll \"{file.path}\""
        },
        "linux": {
          "executable": "retroarch",
          "flatpak": "org.libretro.RetroArch",
          "emudeck_launcher": "retroarch.sh",
          "args": "-L mame_libretro.so \"{file.path}\""
        },
        "macos": {
          "executable": "retroarch",
          "args": "-L mame_libretro.dylib \"{file.path}\""
        }
      },
      "default_core": true
    }
