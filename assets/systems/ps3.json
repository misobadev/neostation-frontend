    {
      "name": "Standalone RPCS3",
      "unique_id": "ps3.rpcs3",
      "description": "Supported extensions: iso, folder.",
      "extensions": [
        "iso",
        "folder"
      ],
      "is_retroachievements_compatible": false,
      "platforms": {
        "windows": {
          "executable": "rpcs3.exe",
          "args": "--no-gui \"{file.path}\""
        },
        "linux": {
          "executable": "rpcs3",
          "flatpak": "net.rpcs3.RPCS3",
          "emudeck_launcher": "rpcs3.sh",
          "args": "--no-gui \"{file.path}\""
        },
        "macos": {
          "executable": "rpcs3",
          "args": "--no-gui \"{file.path}\""
        }
