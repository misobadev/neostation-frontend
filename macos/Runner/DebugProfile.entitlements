<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- App Sandbox is intentionally disabled. A sandboxed process passes its
	     sandbox to the emulators it launches, which stops Ryubing from opening
	     the ROM as a normal macOS application. Debug matches Release so the
	     same launch path can be verified in a debug build. -->
	<!-- Allow loading third-party libraries (important for plugins) -->
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>

	<!-- Allow DYLD variables (standard for release builds) -->
	<key>com.apple.security.cs.allow-dyld-environment-variables</key>
	<true/>

	<!-- Jit/Unsigned exec memory (useful for emulators/Dart) -->
	<key>com.apple.security.cs.allow-jit</key>
	<true/>

	<!-- Network Client (Usually implied but good to be explicit) -->
	<key>com.apple.security.network.client</key>
	<true/>

	<!-- Network Server: the Dart VM Service binds a local port in debug. -->
	<key>com.apple.security.network.server</key>
	<true/>
</dict>
</plist>
