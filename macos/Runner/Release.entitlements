<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Allow loading third-party libraries (important for plugins) -->
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
	
	<!-- Allow DYLD variables (standard for release builds) -->
	<key>com.apple.security.cs.allow-dyld-environment-variables</key>
	<true/>
	
	<!-- Jit/Unsigned exec memory (useful for emulators/Dart) -->
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<key>com.apple.security.cs.allow-unsigned-executable-memory</key>
	<true/>
	
	<!-- Network Client (Usually implied but good to be explicit) -->
	<key>com.apple.security.network.client</key>
	<true/>
</dict>
</plist>
